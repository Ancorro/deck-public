#!/usr/bin/env python3
"""Integrity hashes for the libraries the page loads from CDNs (deck/static/index.html, app/*.js, screen.js). Run it after
changing a library's version and paste what it prints over the old hashes:

    deploy/cdn-sri                  # every CDN URL the page names: classic files, then the import map

A classic file (a <script src> or stylesheet) gets one sha384. A module gets one for itself and for every module it
imports, followed through relative imports, since the import map must list each URL the browser fetches. TipTap
(esm.sh) is left out: esm.sh builds per browser, so a fixed hash would break.
"""
import base64
import hashlib
import json
import re
import sys
import urllib.parse
import urllib.request
from pathlib import Path

STATIC = Path(__file__).resolve().parent.parent / "deck" / "static"
CLASSIC = re.compile(r"""https://(?:cdn\.jsdelivr\.net|cdnjs\.cloudflare\.com)/[^"'`\s]+\.(?:js|css)(?=["'`])""")
MODULES = ["https://cdn.jsdelivr.net/npm/@novnc/novnc@1.7.0/core/rfb.js",  # screen.js
           "https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.min.mjs"]  # app.js loadPdfjs
WORKERS = ["https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.worker.min.mjs"]  # fetched with its hash, run from a blob
IMPORT = re.compile(r"""(?:\bimport\s*(?:[\w*{}\s,$]+\s*from\s*)?|\bexport\s*(?:\*(?:\s+as\s+\w+)?|\{[^}]*\})\s*from\s*"""
                    r"""|\bimport\s*\(\s*)(["'])([^"'\n]+)\1""")


def sri(url: str) -> tuple[str, bytes]:
    body = urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "deck-cdn-sri"}), timeout=30).read()
    return "sha384-" + base64.b64encode(hashlib.sha384(body).digest()).decode(), body


def graph(url: str, out: dict) -> None:
    if url in out:
        return
    out[url], body = sri(url)
    for _, spec in IMPORT.findall(body.decode("utf-8", "replace")):
        if spec.startswith((".", "/")):
            graph(urllib.parse.urljoin(url, spec), out)


def main() -> int:
    pages = [STATIC / "index.html", *sorted((STATIC / "app").glob("*.js"))]  # app.js is served joined from app/
    names = sorted({u for f in pages for u in CLASSIC.findall(f.read_text(encoding="utf-8"))}
                   - set(MODULES) - set(WORKERS))
    print("Classic files (integrity=... crossorigin=\"anonymous\"):")
    for u in names:
        print(f"  {sri(u)[0]}  {u}")
    print("Workers (app.js):")
    for u in WORKERS:
        print(f"  {sri(u)[0]}  {u}")
    mods = {}
    for u in MODULES:
        graph(u, mods)
    print(f"Import map (index.html, {len(mods)} modules):")
    print(json.dumps({"integrity": mods}, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
